Options -Indexes

<IfModule mod_headers.c>
  # Force fresh HTML & dynamic routes everywhere in /fun
  Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0, s-maxage=0"
  Header set Pragma "no-cache"
  Header set Expires "0"

  # Override parent .htaccess for all HTML files in /fun
  <FilesMatch "\.(html|htm)$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0, s-maxage=0"
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0, s-maxage=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Static media assets cache aggressively
  <FilesMatch "\.(woff|woff2|ttf|eot|png|jpg|jpeg|gif|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # JS and CSS cache with revalidation
  <FilesMatch "\.(js|mjs|css)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
</IfModule>
